      <Border Style="{StaticResource SurfacePanel}" Padding="28" Margin="24" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ShutdownTitle" Text="Wrapping up safely…" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="ShutdownStage" MinHeight="64" MaxHeight="180" TextWrapping="Wrap" TextTrimming="WordEllipsis" Margin="0,14,0,8"/>
          <ProgressBar x:Name="ShutdownProgress" Height="8" IsIndeterminate="True" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,12"/>
          <TextBlock Text="All of your saved reviews and scan progress are tucked away safely. You can pick up right where you left off next time." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0"><Button x:Name="ShutdownRetryButton" Content="Retry preferences" Visibility="Collapsed"/><Button x:Name="ShutdownKeepSavedButton" Content="Close with last saved preferences" Visibility="Collapsed"/></WrapPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
